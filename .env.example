# SafePay / DealShield backend — environment variables
#
# Copy this file to .env and fill in real values. Never commit .env.
# The app will refuse to start (RuntimeError) if any of the REQUIRED
# secrets below are missing or still equal to an old insecure default.
#
# Generate a strong random secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── REQUIRED secrets (no safe default — app.main validates these at startup) ──

# JWT signing key for user auth tokens.
SAFEPAY_SECRET_KEY=

# Shared secret n8n/other integrations must send in the X-SafePay-Secret header.
SAFEPAY_WEBHOOK_SECRET=

# Telegram bot auth token used by dealshield-bot / integrations.
BOT_TOKEN=

# ── Optional / has safe defaults ──

DATABASE_URL=sqlite:///./data/safepay.db
SAFEPAY_CORS_ORIGINS=http://localhost:8080
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
TELEGRAM_BOT_TOKEN=
GERALT_TELEGRAM_CHAT_ID=1224185098

# When true (or unset -> defaults to false), allows real wallet deposit/withdraw
# and grants the demo welcome bonus on signup. Keep false in production.
SAFEPAY_TEST_MODE=false
